APP_NAME="Record-breaking"
# In production: APP_ENV=production, APP_DEBUG=false (debug=true leaks stack
# traces, .env values and SQL queries to visitors), APP_URL=https://your-domain.
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Only set this if the app sits behind a known reverse proxy/load balancer
# (Nginx, Cloudflare, etc.) that terminates TLS and forwards X-Forwarded-*
# headers. Leave empty otherwise — trusting proxies you don't control lets
# requests spoof their IP and bypass the login rate limiter.
# TRUSTED_PROXIES=* (or a comma-separated list of proxy IPs)
TRUSTED_PROXIES=

# Only for hosts where you can't run `php artisan storage:link` (no SSH/CLI)
# and can't create the symlink by hand either — set to true to write public
# uploads (exercise photos) straight into public/storage instead.
PUBLIC_DISK_DIRECT=false

# Only if the app had to be installed as a sibling of public_html instead of
# public/ being the real web root (typical on a no-SSH host where you can't
# symlink or move things properly) — the absolute server path to public_html.
# Leave empty everywhere public/ itself is the web root.
PUBLIC_HTML_PATH=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=record_breaking
DB_USERNAME=record_breaking
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# In production (once served over HTTPS): SESSION_SECURE_COOKIE=true, so the
# session/CSRF cookies are never sent over a plain HTTP connection.
SESSION_SECURE_COOKIE=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
